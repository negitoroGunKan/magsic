{
    "compilerOptions": {
        "target": "es2016",
        "module": "es2020",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true
    },
    "include": ["magusic.ts", "src/**/*.ts"],
    "exclude": ["src/**/*.test.ts"]
}
